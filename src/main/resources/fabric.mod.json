{
  "schemaVersion": 1,
  "id": "pre",
  "version": "${version}",
  "name": "ProgressionReEnvisioned",
  "description": "Changes the progression enough to be understandable but interesting. Also adds fun trinkets to mess with and QOL Improvements.",
  "authors": [
    "lixir",
    "TCGaming55",
    "Powercyphe",
    "mongocat"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/pre/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "net.lixir.pre.common.datagen.PREDataGenerator"
    ],
    "client": [
      "net.lixir.pre.client.PREClient"
    ],
    "main": [
      "net.lixir.pre.common.ProgressionReEnvisioned"
    ],
    "cardinal-components-entity": [
      "net.lixir.pre.common.init.PREEntityComponents"
    ]
  },
  "accessWidener": "pre.accesswidener",
  "mixins": [
    "pre.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "java": ">=21",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "cardinal-components": [
      "pre:rewind"
    ],
    "loom:injected_interfaces": {
      "net/minecraft/item/Item": [
        "net/lixir/pre/common/duck/item/ItemDuck"
      ],
      "net/minecraft/entity/player/PlayerEntity": [
        "net/lixir/pre/common/duck/entity/player/PlayerEntityDuck"
      ]
    }
  }
}
